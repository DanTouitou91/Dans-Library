/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

# ‎הספריות נעולות לגרסה מדויקת ולעולם לא משתנות תחת אותו נתיב.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# ‎ה-PDF-ים גדולים; שמירה במטמון ליום, עם אימות מחדש.
/books/*
  Cache-Control: public, max-age=86400, must-revalidate

# ‎ה-HTML עצמו תמיד טרי, כדי ששינוי במערך הספרים יופיע מיד.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
