# ‎הערה על style-src ו-'unsafe-inline':
# ‎StPageFlip ממקם כל עלה בזמן הדפדוף דרך element.style.cssText, ו-CSP חוסם
# ‎את זה ללא 'unsafe-inline'. בלי ההיתר הזה הקורא נטען אבל נשאר ריק לגמרי
# ‎(נבדק). ההגנה המשמעותית נשארת: script-src הוא 'self' בלבד, בלי
# ‎unsafe-inline ובלי unsafe-eval.
#
# ‎הערה על Google Analytics:
# ‎‏gtag.js נטען מ-googletagmanager.com ומשדר ל-google-analytics.com, ולכן
# ‎שלושת המקורות האלה נוספו ל-script-src, ל-connect-src ול-img-src. הקוד
# ‎המוטבע שגוגל מספקת הועבר ל-assets/analytics.js **בכוונה**: הוספת
# ‎'unsafe-inline' ל-script-src הייתה פותחת את האתר להזרקת קוד, וזה מחיר
# ‎גבוה בהרבה מקובץ נפרד אחד. script-src נשאר בלי unsafe-inline.

#
# ‎הערה על media-src (סִפְרִיַּית הַקַּלָּטוֹת):
# ‎הסרטונים גדולים מדי למאגר ויושבים ב-GitHub Releases. הכתובת ב-github.com
# ‎מחזירה 302 לכתובת חתומה ב-release-assets.githubusercontent.com, ו-CSP
# ‎בודק גם את יעד ההפניה — לכן שני המארחים חייבים להופיע. objects.* הוא
# ‎המארח הקודם של GitHub לאותם קבצים, למקרה שיחזרו אליו. בלי media-src
# ‎בכלל הכלל נופל ל-default-src 'self', והסרטון נחסם בשקט.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; media-src 'self' https://github.com https://release-assets.githubusercontent.com https://objects.githubusercontent.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

# ‎הספריות נעולות לגרסה מדויקת ולעולם לא משתנות תחת אותו נתיב.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# ‎⚠️ אל תחזירו כאן max-age ארוך.
# ‎Netlify מתאימה כללי כותרות לפי *הנתיב* ולא לפי הסטטוס, ולכן הכלל חל גם
# ‎על תשובת 404. כשספר מופיע בקטלוג לפני שהקובץ שלו הועלה, הדפדפן שמר
# ‎את ה-404 ליממה שלמה — והספר נשאר שבור אצל אותו משתמש גם אחרי
# ‎שהקובץ עלה, בלי שום דרך לדעת זאת מהשרת. זה קרה בפועל.
# ‎max-age=0 עם must-revalidate שומר על היעילות דרך ETag (תשובת 304
# ‎זעירה במקום 2MB), ומונע לחלוטין שמירת שגיאות במטמון.
/books/*
  Cache-Control: public, max-age=0, must-revalidate

# ‎⚠️ קוד האתר חייב כלל מפורש — לכל קובץ בנפרד.
# ‎שתי טעויות היו כאן, ושתיהן גרמו למשתמש להריץ קוד ישן בלי לדעת:
# ‎  1. ל-script.js ול-style.css לא היה שום כלל. בלי הנחיה מפורשת דפדפן
# ‎     מחיל "מטמון היוריסטי" משלו — ספארי בנייד עושה זאת באגרסיביות —
# ‎     וגרסאות חדשות פשוט לא הגיעו.
# ‎  2. הכלל היה /index.html בלבד, אבל הכתובת שאליה נכנסים היא "/".
# ‎     Netlify מתאימה לפי נתיב הבקשה, ולכן הכלל לא חל על דף הבית כלל.
# ‎הנתיבים כאן מפורטים אחד-אחד בכוונה, כדי שלא ייווצר כפל עם /vendor/*
# ‎(שהוא היחיד שנשמר לשנה, כי הוא נעול לגרסה ולעולם לא משתנה).
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/script.js
  Cache-Control: public, max-age=0, must-revalidate
/style.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/*
  Cache-Control: public, max-age=0, must-revalidate
# ‎סִפְרִיַּית הַקַּלָּטוֹת. ‏/videos — כי Netlify מגישה videos.html גם בלי הסיומת,
# ‎וכלל לפי נתיב לא יחול על הכתובת הזו אם לא נכתוב אותה במפורש (כמו "/").
/videos
  Cache-Control: public, max-age=0, must-revalidate
/videos.html
  Cache-Control: public, max-age=0, must-revalidate
/videos.js
  Cache-Control: public, max-age=0, must-revalidate
/videos.css
  Cache-Control: public, max-age=0, must-revalidate
/tapes.json
  Cache-Control: public, max-age=0, must-revalidate
