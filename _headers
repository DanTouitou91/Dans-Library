# ‎הערה על style-src ו-'unsafe-inline':
# ‎StPageFlip ממקם כל עלה בזמן הדפדוף דרך element.style.cssText, ו-CSP חוסם
# ‎את זה ללא 'unsafe-inline'. בלי ההיתר הזה הקורא נטען אבל נשאר ריק לגמרי
# ‎(נבדק). ההגנה המשמעותית נשארת: script-src הוא 'self' בלבד, בלי
# ‎unsafe-inline ובלי unsafe-eval.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'

# ‎הספריות נעולות לגרסה מדויקת ולעולם לא משתנות תחת אותו נתיב.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# ‎⚠️ אל תחזירו כאן max-age ארוך.
# ‎Netlify מתאימה כללי כותרות לפי *הנתיב* ולא לפי הסטטוס, ולכן הכלל חל גם
# ‎על תשובת 404. כשספר מופיע בקטלוג לפני שהקובץ שלו הועלה, הדפדפן שמר
# ‎את ה-404 ליממה שלמה — והספר נשאר שבור אצל אותו משתמש גם אחרי
# ‎שהקובץ עלה, בלי שום דרך לדעת זאת מהשרת. זה קרה בפועל.
# ‎max-age=0 עם must-revalidate שומר על היעילות דרך ETag (תשובת 304
# ‎זעירה במקום 2MB), ומונע לחלוטין שמירת שגיאות במטמון.
/books/*
  Cache-Control: public, max-age=0, must-revalidate

# ‎ה-HTML עצמו תמיד טרי, כדי ששינוי במערך הספרים יופיע מיד.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
